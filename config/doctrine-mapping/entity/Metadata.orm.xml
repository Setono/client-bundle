<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- Used when Setono\ClientBundle\Entity\Metadata is the metadata class (the default) -->
    <entity name="Setono\ClientBundle\Entity\Metadata" table="setono_client__metadata">
        <id name="clientId" type="string"/>
        <field name="metadata" type="json" nullable="true"/>
    </entity>
</doctrine-mapping>
